frontend/dist/
frontend/build/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ----- Docker -----
postgres_data/
redis_data/

# ----- Testing -----
.pytest_cache/
htmlcov/
.coverage
coverage/

# ----- Misc -----
*.log
.env.local
.ruff_cache/
.pytest_cache/
